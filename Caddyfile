# Caddy terminates HTTPS with auto-renewed Let's Encrypt certificates
# and forwards plain HTTP to the API containers.
#
# SITE_ADDRESS (from .env) is the domain, e.g. fcpxstudio.shop. Both
# api.<domain> and <domain> need a DNS A record pointing to the VPS.
#
# Each API serves its own prefix, /<API_NAME>/<API_VERSION>/ (e.g. /auth/v1/),
# so Caddy routes on the first path segment and keeps the path as is.
#
# <domain> serves the APIs too for now. When the website moves to it, give it
# its own site block and keep only api.<domain> here.

api.{$SITE_ADDRESS}, {$SITE_ADDRESS} {
	handle /auth/* {
		reverse_proxy auth-api:8000
	}

	# Public catalog, read by the website server-side (read-only, catalog tables only)
	handle /data/* {
		reverse_proxy data-api:8000
	}

	# Paddle webhooks + the website's license claims (/events/v1/web/*).
	# Never set `trusted_proxies`: without it, Caddy replaces any X-Forwarded-For sent by a client, so
	# EventAPI's per-IP claim limits see the real client address (uvicorn --proxy-headers)
	handle /events/* {
		reverse_proxy event-api:8000
	}

	handle {
		respond 404
	}
}

# MQTT broker (Mosquitto, port 8883). Caddy doesn't proxy it: this block only makes Caddy obtain and
# renew the certificate of mqtt.<domain>, which mosquitto/sync-certs.sh copies to Mosquitto.
# Needs a DNS A record for mqtt.<domain> pointing to the VPS
mqtt.{$SITE_ADDRESS} {
	respond 404
}
