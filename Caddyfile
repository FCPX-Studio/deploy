# Caddy terminates HTTPS with auto-renewed Let's Encrypt certificates
# and forwards plain HTTP to the API containers.
#
# SITE_ADDRESS (from .env) is the domain, e.g. fcpxstudio.shop. Both
# api.<domain> and <domain> need a DNS A record pointing to the VPS.
#
# Each API serves its own prefix, /<API_NAME>/<API_VERSION>/ (e.g. /auth/v1/),
# so Caddy routes on the first path segment and keeps the path as is.
#
# <domain> serves the APIs too for now. When the website moves to it, give it
# its own site block and keep only api.<domain> here.

api.{$SITE_ADDRESS}, {$SITE_ADDRESS} {
	handle /auth/* {
		reverse_proxy auth-api:8000
	}

	# Paddle webhooks + SSE to the website (Caddy flushes text/event-stream as it comes)
	handle /events/* {
		reverse_proxy event-api:8000
	}

	handle {
		respond 404
	}
}
