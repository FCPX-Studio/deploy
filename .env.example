# Copy to .env on the VPS (gitignored). Read by docker compose for ${...} in docker-compose.yml.

# Domain, used by Caddy for HTTPS: serves api.<domain> and <domain> (see Caddyfile)
SITE_ADDRESS=fcpxstudio.shop

# Image tags on ghcr.io/fcpx-studio/*

# db migrations: a git tag of the db repo.
# Must be >= the highest db tag pinned in any service's requirements.txt
DB_MIGRATE_TAG=v0.1.1

# Services run :latest by default (every push to main publishes :latest and :sha-<commit>).
# Only to roll back, uncomment one, e.g. AUTH_API_TAG=sha-abc1234, then: docker compose up -d auth-api
# AUTH_API_TAG=
# EVENT_API_TAG=
# PADDLESYNC_TAG=
# EMAILTALKER_TAG=
