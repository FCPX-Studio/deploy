# Copy to .env on the VPS (gitignored). Read by docker compose for ${...} in docker-compose.yml.

# Public IP of the VPS (or a domain name later), used by Caddy for HTTPS
SITE_ADDRESS=

# Image tags on ghcr.io/fcpx-studio/* (git tags of each repo)
# DB_MIGRATE_TAG must be >= the highest db tag pinned by any service
DB_MIGRATE_TAG=v0.1.1
AUTH_API_TAG=v1.0.0
EVENTS_API_TAG=
PADDLESYNC_TAG=
EMAILTALKER_TAG=
