# Schema owner: used only by db-migrate (same values in db-migrate.env)
POSTGRES_USER=fcpx_owner
POSTGRES_PASSWORD=
POSTGRES_DB=fcpx

# Services' role, created on first start by postgres/init/01-app-role.sh
# (same values as DB_USER / DB_PASSWORD in the services' env files)
APP_DB_USER=fcpx_app
APP_DB_PASSWORD=
