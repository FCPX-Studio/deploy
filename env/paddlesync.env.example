DB_HOST=postgres
DB_PORT=5432
DB_NAME=fcpxstudio_db
DB_USER=service
DB_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

PADDLE_API_KEY=
# sandbox | production
PADDLE_ENVIRONMENT=sandbox

