# Postgres, read by the shared `db` package.
# The read-only role (DATA_API_DB_* in postgres.env): SELECT on the catalog tables only
DB_HOST=postgres
DB_PORT=5432
DB_NAME=fcpxstudio_db
DB_USER=data_api
DB_PASSWORD=

# Logs to MQTT (logger package): this service's Mosquitto account, created with mosquitto/passwd.sh dataapi
MQTT_USERNAME=dataapi
MQTT_PASSWORD=
