# Website: the origins allowed to call /events/v1/web/* from a browser (CORS), comma-separated. Required.
# Exactly what the browser shows: https or http, with or without www, the port if not the default
WEBSITE_ORIGIN=https://fcpxstudio.shop,https://www.fcpxstudio.shop

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

PADDLE_WEBHOOK_SECRET=
# sandbox | production
PADDLE_ENVIRONMENT=sandbox

# License claims from the confirmation page (defaults shown)
# CLAIM_WAIT_SECONDS=20
# CLAIM_MAX_WAITS_PER_IP=3
# CLAIM_MAX_REQUESTS_PER_MINUTE=10
# CLAIM_MAX_WAITS=500

# Logs to MQTT (logger package): this service's Mosquitto account, created with mosquitto/passwd.sh eventapi
MQTT_USERNAME=eventapi
MQTT_PASSWORD=
